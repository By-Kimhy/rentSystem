# MySQL connection string
DATABASE_URL="mysql://rent:rent@localhost:3306/rentsystem"

# Secret used to sign session tokens. The API signs them and the web app checks them, so both
# read this same value. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@rentsystem.local"
ADMIN_PASSWORD="admin12345"

# Where the web app finds the API, and the API's own port
API_URL="http://localhost:4000"
API_PORT=4000

# Browser origins allowed to call the API directly with cookies (comma-separated)
CORS_ORIGINS="http://localhost:3000"

# Folder where the API stores property and room photos (relative to the repository root)
UPLOAD_DIR="./uploads"

# Day boundary for rent due dates and overdue checks (an IANA time zone, e.g. Asia/Phnom_Penh)
BILLING_TIMEZONE="UTC"

# Bearer token for the daily billing endpoint POST /api/cron/billing on the API (optional)
CRON_SECRET=""

# Email. Without SMTP_URL nothing is sent; each message is only logged by the API.
# Any SMTP server works, e.g. smtp://localhost:1025 for a local Mailpit test inbox, or
# smtps://resend:<API_KEY>@smtp.resend.com:465 for Resend.
SMTP_URL=""
MAIL_FROM="RentSystem <no-reply@rentsystem.local>"
# The web app's public address, used for links in emails
APP_URL="http://localhost:3000"
