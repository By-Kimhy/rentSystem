# MySQL connection string
DATABASE_URL="mysql://rent:rent@localhost:3306/rentsystem"

# Secret used to sign session tokens. The API signs them and the web app checks them, so both
# read this same value. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@rentsystem.local"
ADMIN_PASSWORD="admin12345"

# Where the web app finds the API, and the API's own port
API_URL="http://localhost:4000"
API_PORT=4000

# Browser origins allowed to call the API directly with cookies (comma-separated)
CORS_ORIGINS="http://localhost:3000"

# Folder where the API stores property and room photos (relative to the repository root)
UPLOAD_DIR="./uploads"

# Day boundary for rent due dates and overdue checks (an IANA time zone, e.g. Asia/Phnom_Penh)
BILLING_TIMEZONE="UTC"

# Bearer token for the daily billing endpoint POST /api/cron/billing on the API (optional)
CRON_SECRET=""

# Google Analytics 4 measurement ID for the web app, e.g. G-XXXXXXXXXX (optional; leave empty to
# load no analytics). It is built into the browser code, so rebuild after changing it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ---- Email (password reset links and rent reminders)
# The web app's public address, used for links in emails
APP_URL="http://localhost:3000"
# How email is sent: "console" prints it to the API log (default, for development), "smtp" or "resend"
# send it for real, "none" turns email off
MAIL_PROVIDER="console"
MAIL_FROM="RentSystem <no-reply@rentsystem.local>"
# For MAIL_PROVIDER=smtp: either one URL, e.g. smtps://user:app-password@smtp.gmail.com:465 ...
SMTP_URL=""
# ... or the parts (SMTP_SECURE defaults to true on port 465)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# For MAIL_PROVIDER=resend (https://resend.com)
RESEND_API_KEY=""

# ---- Email reminders. The API sends them by itself every hour from REMINDER_HOUR (local time in
# BILLING_TIMEZONE); set REMINDER_SCHEDULER=off to send them only via POST /api/cron/reminders.
REMINDER_SCHEDULER="on"
REMINDER_HOUR=9
# Days before the due date for the "rent due soon" email
REMINDER_DUE_DAYS=3
# Overdue emails: one when the invoice turns overdue, then every N days, at most MAX in all
REMINDER_OVERDUE_EVERY_DAYS=7
REMINDER_OVERDUE_MAX=3
