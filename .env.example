# PostgreSQL connection string
DATABASE_URL="postgresql://rent:rent@localhost:5432/rentsystem?schema=public"

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@rentsystem.local"
ADMIN_PASSWORD="admin12345"

# Folder where property and room photos are stored
UPLOAD_DIR="./uploads"

# Day boundary for rent due dates and overdue checks (an IANA time zone, e.g. Asia/Phnom_Penh)
BILLING_TIMEZONE="UTC"

# Bearer token for the daily billing endpoint GET /api/cron/billing (optional)
CRON_SECRET=""
