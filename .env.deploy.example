# Settings for `docker compose --env-file .env.deploy up -d --build`. Copy to .env.deploy and fill in.
# Generate secrets with: openssl rand -base64 32

# The site's public address (used for links in emails and as the allowed browser origin)
APP_URL="https://rent.example.com"
# Port on the host for the web app; put a reverse proxy with HTTPS (Caddy, nginx) in front of it
WEB_PORT=3000

MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
SESSION_SECRET=""
CRON_SECRET=""

# The admin account `npm run db:seed` creates (run once, see README)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Day boundary for rent due dates (an IANA time zone, e.g. Asia/Phnom_Penh)
BILLING_TIMEZONE="UTC"

# Email (see README "Emails"). Leave SMTP_URL empty to only log emails.
SMTP_URL=""
MAIL_FROM="RentSystem <no-reply@example.com>"
